# ===== Sa Majesté le Poilu — secrets locaux (JAMAIS commité) ====
# Copiez ce fichier vers .env puis remplissez vos valeurs réelles.
# Windows (Git Bash) : cp .env.example .env
# En local, ces valeurs sont lues automatiquement au démarrage (python app.py).
# Sur Render, ce fichier n'est PAS lu : les mêmes clés sont saisies dans
# Dashboard > Environment (voir guide de déploiement).

# --- Stripe (mode Test) ---
# Clé secrète de test depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Secret de signature webhook (Dashboard > Développeurs > Webhooks)
#facultatif en dev avec `stripe listen --forward-to 127.0.0.1:5000/webhook-stripe`
STRIPE_WEBHOOK_SECRET=

# --- SMTP transactionnel (Gmail, mot de passe d'application) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Ancien fallback Mailtrap (sandbox, si MAIL_* absent) ---
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# --- Flask ---
# Clé de session Flask (générez : python -c "import secrets; print(secrets.token_hex(32))")
# OBLIGATOIRE sur Render : sans elle, les sessions admin/panier sont perdues à chaque redémarrage.
FLASK_SECRET_KEY=

# --- Runtime (facultatif en local) ---
# PORT=5000          # port du serveur ; Render le définit lui-même
# FLASK_DEBUG=true   # mode debug Flask (false en production)
# DATA_DIR=/var/data # emplacement des données JSON (disque persistant Render)
# UPLOAD_DIR=/var/data/uploads  # emplacement des uploads (optionnel)

# --- Brevo (ex-Sendinblue) : inscriptions newsletter poussées en ligne ---
# Clé API REST : app.brevo.com/settings/keys/api — elle commence par xkeysib-
# (une clé xsmtpsib- est une clé SMTP, elle ne fonctionne PAS avec l'API).
# Sans clé, les inscriptions restent simplement enregistrées en local.
BREVO_API_KEY=
# Liste Brevo qui reçoit les inscriptions (2 = liste par défaut)
BREVO_LIST_ID=2

# --- Gelato (impression à la demande / POD) ---
# Clé API Gelato : dashboard.gelato.com > Settings > API keys.
# En-tête X-API-KEY envoyé sur POST https://order.gelatoapis.com/v4/orders
# dès la validation d'un paiement Stripe contenant un article POD.
# Sans clé, l'envoi n'a pas lieu (la commande reste payée, tentable plus tard).
GELATO_API_KEY=
# Mode de livraison Gelato (facultatif, ex. standard / express) :
# GELATO_SHIPMENT_METHOD=
# Chaque article POD doit aussi porter son productUid Gelato :
# gelato_product_uid (+ gelato_print_file_url / gelato_print_type)
# renseignés sur le produit dans Admin > Produits.

# --- CJ Dropshipping API v2 ---
# CJ_EMAIL sert à documenter le compte associé à la clé.
# L'endpoint d'authentification CJ utilise CJ_API_KEY.
CJ_EMAIL=
CJ_API_KEY=

# --- Synchronisation CJ (stock/prix) ---
# CJ_SYNC_INTERVAL_HOURS=24
