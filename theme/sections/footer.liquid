{%- comment -%} Section Footer — Sa Majesté le Poilu (menus 100 % dynamiques Shopify) {%- endcomment -%}
<footer class="footer">
  <div class="container">
    {%- if section.settings.show_newsletter -%}
      {% section 'newsletter' %}
    {%- endif -%}

    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-logo">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 96 }}"
              alt="{{ shop.name }}"
              class="footer-mascot"
              width="40" height="40"
              loading="lazy"
            >
          {%- endif -%}
          <span>{{ section.settings.brand_text | default: shop.name }}</span>
        </p>
        <p>{{ section.settings.brand_description }}</p>

        <ul class="footer-social" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' and block.settings.link != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" aria-label="{{ block.settings.name | escape }}">{{ block.settings.icon }} {{ block.settings.name }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Colonnes dynamiques : chaque colonne = un menu Shopify (linklist) choisi dans l'éditeur {%- endcomment -%}
      {%- assign menus = section.settings.menu_boutique, section.settings.menu_infos, section.settings.menu_legal -%}
      {%- assign titles = section.settings.title_boutique, section.settings.title_infos, section.settings.title_legal -%}
      {%- for m in menus -%}
        {%- if m != blank -%}
          <div class="footer-col">
            <h3>{{ titles[forloop.index0] }}</h3>
            <ul role="list">
              {%- for link in m.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — Tous droits réservés à Sa Majesté.</p>
      <ul class="payment-badges" role="list" aria-label="Paiements sécurisés">
        {%- if section.settings.payment_badges_text != blank -%}
          {%- assign badges = section.settings.payment_badges_text | split: ';' -%}
          {%- for badge in badges -%}
            <li>{{ badge | strip }}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "header", "content": "Marque & newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher la newsletter", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Mascotte footer" },
    { "type": "text", "id": "brand_text", "label": "Nom de marque", "default": "👑 Sa Majesté le Poilu" },
    { "type": "textarea", "id": "brand_description", "label": "Description marque", "default": "Accessoires et vêtements personnalisés pour animaux rois et serviteurs dévoués. Imprimé en France avec amour." },

    { "type": "header", "content": "Menus dynamiques (Navigation Shopify)" },
    { "type": "text",  "id": "title_boutique", "label": "Titre colonne 1", "default": "Boutique" },
    {
      "type": "link_list",
      "id": "menu_boutique",
      "label": "Menu colonne 1 (Boutique)",
      "default": "main-menu",
      "info": "Choisissez un menu créé dans Navigation > Menus"
    },
    { "type": "text",  "id": "title_infos", "label": "Titre colonne 2", "default": "Informations" },
    {
      "type": "link_list",
      "id": "menu_infos",
      "label": "Menu colonne 2 (Informations)",
      "default": "footer"
    },
    { "type": "text",  "id": "title_legal", "label": "Titre colonne 3", "default": "Légal" },
    {
      "type": "link_list",
      "id": "menu_legal",
      "label": "Menu colonne 3 (Légal)",
      "default": "footer"
    },

    { "type": "header", "content": "Bas de page" },
    { "type": "text", "id": "payment_badges_text", "label": "Badges paiement (séparés par ;)", "default": "💳 Visa;💳 Mastercard;🅿️ PayPal;🍎 Apple Pay" }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Réseau social",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Instagram" },
        { "type": "text", "id": "icon", "label": "Emoji icône", "default": "📸" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        { "type": "social", "settings": { "name": "Instagram", "icon": "📸" } },
        { "type": "social", "settings": { "name": "TikTok", "icon": "🎵" } },
        { "type": "social", "settings": { "name": "Facebook", "icon": "👍" } }
      ]
    }
  ]
}
{% endschema %}
