{%- comment -%} Section Grille de catégories Pop-Art {%- endcomment -%}
<section class="categories" id="categories" aria-labelledby="categories-title">
  <div class="container">
    <h2 id="categories-title" class="section-title">{{ section.settings.heading }} <span class="title-accent">{{ section.settings.heading_accent }}</span></h2>
    <p class="section-subtitle">{{ section.settings.subheading }}</p>

    {%- if section.blocks.size > 0 -%}
      <ul class="categories-grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign cat_collection = collections[block.settings.collection] -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: cat_collection.url | default: routes.all_products_collection_url }}" class="category-card">
              {%- if block.settings.image != blank -%}
                <span class="category-media">
                  <img
                    src="{{ block.settings.image | image_url: width: 240 }}"
                    alt="{{ block.settings.title | escape }}"
                    width="240" height="240"
                    loading="lazy"
                  >
                </span>
              {%- else -%}
                <span class="category-emoji" aria-hidden="true">{{ block.settings.emoji | default: '🐾' }}</span>
              {%- endif -%}
              <span class="category-name">{{ block.settings.title | escape }}</span>
              {%- if block.settings.count_text != blank -%}
                <span class="category-count">{{ block.settings.count_text | escape }}</span>
              {%- elsif cat_collection != blank -%}
                <span class="category-count">{{ cat_collection.all_products_count }} modèles</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Catégories royales",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Collection Royale" },
    { "type": "text", "id": "heading_accent", "label": "Mot accentué", "default": "par univers" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Chaque article est personnalisable (photo, nom, blague couronnée d'or)." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Mugs & Tasses" },
        { "type": "image_picker", "id": "image", "label": "Image (optionnelle — remplace l'emoji)" },
        { "type": "text", "id": "emoji", "label": "Emoji (si pas d'image)", "default": "☕" },
        { "type": "text", "id": "count_text", "label": "Texte « X modèles » (auto si lié à une collection)", "default": "24 modèles" },
        { "type": "collection", "id": "collection", "label": "Collection Shopify (liée)" },
        { "type": "url", "id": "link", "label": "Lien personnalisé (prioritaire sur la collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catégories royales",
      "blocks": [
        { "type": "category", "settings": { "title": "Mugs & Tasses", "emoji": "☕", "count_text": "24 modèles" } },
        { "type": "category", "settings": { "title": "Paillassons", "emoji": "🚪", "count_text": "12 modèles" } },
        { "type": "category", "settings": { "title": "Bandanas & Vêtements", "emoji": "🦴", "count_text": "31 modèles" } },
        { "type": "category", "settings": { "title": "Coussins & Plaids", "emoji": "🛏️", "count_text": "18 modèles" } },
        { "type": "category", "settings": { "title": "Plaques & Médailles", "emoji": "🎖️", "count_text": "9 modèles" } }
      ]
    }
  ]
}
{% endschema %}
