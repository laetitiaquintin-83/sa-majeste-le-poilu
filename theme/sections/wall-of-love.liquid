{%- comment -%} Section Wall of Love (avis clients) {%- endcomment -%}
<section class="reviews" id="avis" aria-labelledby="reviews-title">
  <div class="container">
    <h2 id="reviews-title" class="section-title">{{ section.settings.heading }} <span class="title-accent">{{ section.settings.heading_accent }}</span></h2>
    <p class="section-subtitle">{{ section.settings.subheading }}</p>

    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <figure class="review-card" {{ block.shopify_attributes }}>
          <div class="review-head">
            {%- if block.settings.avatar != blank -%}
              <img
                class="review-avatar review-avatar--img"
                src="{{ block.settings.avatar | image_url: width: 96 }}"
                alt="{{ block.settings.author | escape }}"
                width="48" height="48"
                loading="lazy"
              >
            {%- else -%}
              <span class="review-avatar" aria-hidden="true">{{ block.settings.emoji | default: '🐾' }}</span>
            {%- endif -%}
            <div>
              <cite>{{ block.settings.author }}</cite>
              <span class="stars" aria-label="Note : {{ block.settings.stars }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}
                {%- endfor -%}
              </span>
            </div>
          </div>
          {%- if block.settings.photo != blank -%}
            <img
              class="review-photo"
              src="{{ block.settings.photo | image_url: width: 520 }}"
              alt="Photo de {{ block.settings.author | escape }}"
              width="520"
              height="{{ 520 | divided_by: block.settings.photo.aspect_ratio | round }}"
              loading="lazy"
            >
          {%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wall of Love",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Wall of Love" },
    { "type": "text", "id": "heading_accent", "label": "Mot accentué", "default": "💛" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Les serviteurs témoignent. Leurs majestés hébêtent approbatives." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "text", "id": "author", "label": "Nom + animal", "default": "Julie M. & Hachiko" },
        { "type": "range", "id": "stars", "label": "Étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Avis", "default": "« Le paillasson est un chef-d'œuvre. Hachiko l'a déjà ignoré avec une élégance royale. »" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar photo (optionnel)" },
        { "type": "text", "id": "emoji", "label": "Emoji (si pas d'avatar)", "default": "🐕" },
        { "type": "image_picker", "id": "photo", "label": "Photo de l'animal (optionnelle)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wall of Love",
      "blocks": [
        { "type": "review", "settings": { "author": "Julie M. & Hachiko", "emoji": "🐕" } },
        { "type": "review", "settings": { "author": "Karim B. & Pikachu", "emoji": "🐈" } },
        { "type": "review", "settings": { "author": "Sophie L. & Bonbon", "emoji": "🐩" } },
        { "type": "review", "settings": { "author": "Thomas P. & Croquette", "emoji": "🐹" } }
      ]
    }
  ]
}
{% endschema %}
